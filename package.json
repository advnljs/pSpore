{
  "name": "p-spore",
  "version": "0.1.39",
  "description": "Linux-first local proactive agent built on Pi",
  "keywords": [
    "ai",
    "agent",
    "cli",
    "tui",
    "automation",
    "mcp"
  ],
  "homepage": "https://github.com/advnljs/pSpore#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/advnljs/pSpore.git"
  },
  "bugs": {
    "url": "https://github.com/advnljs/pSpore/issues"
  },
  "type": "module",
  "files": [
    "dist/**/*"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "bin": {
    "pspore": "dist/cli/main.js",
    "p-spore": "dist/cli/main.js"
  },
  "scripts": {
    "build": "node scripts/clean-dist.mjs && tsc -p tsconfig.build.json && node scripts/copy-desktop-assets.mjs",
    "package:desktop": "bash scripts/package-desktop.sh",
    "desktop": "npm run build && electron dist/desktop/main.js",
    "dev": "tsx src/cli/main.ts",
    "start": "node dist/cli/main.js",
    "prepack": "npm run build",
    "prepublishOnly": "npm run check",
    "test": "tsx --test test/**/*.test.ts",
    "test:electron": "npm run build && node scripts/electron-smoke.mjs",
    "test:article-stream": "npm run build && node scripts/article-stream-smoke.mjs",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.84.1",
    "@earendil-works/pi-tui": "0.84.1",
    "@modelcontextprotocol/sdk": "1.30.0",
    "croner": "10.0.1",
    "pdfjs-dist": "6.3.289",
    "typebox": "1.3.7"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.84.1",
    "@types/node": "24.13.3",
    "electron": "43.3.0",
    "gsap": "^3.15.0",
    "tsx": "4.23.11",
    "typescript": "5.9.3"
  },
  "overrides": {
    "@earendil-works/pi-agent-core": "0.84.1",
    "@earendil-works/pi-ai": "0.84.1",
    "@earendil-works/pi-client": "0.84.1",
    "@earendil-works/pi-coding-agent": "0.84.1",
    "@earendil-works/pi-protocol": "0.84.1",
    "@earendil-works/pi-telemetry": "0.84.1",
    "@earendil-works/pi-tui": "0.84.1"
  }
}
